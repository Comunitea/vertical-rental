<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="rental_list" name="Rental list item">
        <t t-call="website.layout">
            <t t-set="page_title" t-value="Rental" />
            <div class="wrap" id="rental_list">
                <div class="oe_structure mt-4">
                    <div class="container py-2 oe_website_sale">
                        <div class="row">
                            <div class="col-sm-12 col-md-6 col-lg-4">
                                <div class="row">
                                    <div class="col-12" style="height:1px !important;">
                                        <form method="post" class="rental_form" t-attf-action="/rental/">
                                            <div class="rental_calendar">
                                                <div class="row input-daterange input-group" id="rental-datepicker">
                                                    <div id="start_date" class="col-6 form-item bg_calendar daterangepicker">
                                                        <label>Pickup</label>
                                                        <input type="date" t-att-min="min_date" t-att-max="max_date" class="form-control" id="start-date" name="start" t-att-value="start_date" />
                                                    </div>
                                                    <div id="end_date" class="col-6 form-item bg_calendar daterangepicker">
                                                        <label>Delivery</label>
                                                        <input type="date" t-att-min="min_end_date" t-att-max="max_date" class="form-control" id="end-date" name="end" t-att-value="end_date" />
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-6 form-item">
                                                        <button class="btn btn-secondary btn-block mt-2 reset_dates" type="button">
                                                            Reset
                                                        </button>
                                                    </div>
                                                    <div class="col-6 form-item">
                                                        <input type="submit" class="btn btn-primary btn-block mt-2" value="Filter" />
                                                    </div>
                                                </div>
                                            </div>
                                        </form>
                                        <br />
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-12 col-md-6 col-lg-8" id="rental_products_list">
                                <div class="row">
                                    <t t-if="object_list">
                                        <t t-foreach="object_list" t-as="product">
                                            <div class="col-4 card card_rental_list float-left">
                                                <a t-attf-href="{{ product.product_tmpl_id.website_url }}?start={{start_date}}&amp;end={{end_date}}" t-attf-title="{{ product.name }}">
                                                    <img t-att-src="website.image_url(product, 'image_512')" width="100%" height="100%" t-att-title="product.name" t-att-alt="product.name" />
                                                </a>
                                                <div class="card-body">
                                                    <a t-attf-href="{{ product.product_tmpl_id.website_url }}?start={{start_date}}&amp;end={{end_date}}" t-attf-title="{{ product.name }}">
                                                        <h5 class="card-title">
                                                            <t t-esc="product.name" />
                                                        </h5>
                                                    </a>
                                                    <p>
                                                        <a t-attf-href="{{ product.product_tmpl_id.website_url }}?start={{start_date}}&amp;end={{end_date}}" t-attf-title="{{ product.name }}" class="btn btn-outline-primary">
                                                            Rent now from
                                                            <t t-esc="product.list_price" t-options='{"widget": "float", "precision": 2}' />
                                                            €
                                                        </a>
                                                    </p>
                                                </div>
                                            </div>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <p>Not results in dates.</p>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
